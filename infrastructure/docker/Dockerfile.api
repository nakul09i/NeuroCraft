# NeuroCraft API Gateway Dockerfile (Phase 0 Scaffold)
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd -g 10001 neurocraft && \
    useradd -u 10001 -g neurocraft -s /bin/sh neurocraft

COPY pyproject.toml .
# Dependency install will happen in Phase 1+
# RUN pip install --no-cache-dir .

COPY . .

USER neurocraft

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "neurocraft_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
