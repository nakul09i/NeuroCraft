rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // NeuroCraft Security Rules
    // Principle: Strict tenant isolation. Users can access ONLY their own data.
    // Zero public access allowed.
    // =========================================================================

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated user private root document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User Scans (metadata only, no raw binary storage)
      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User Reports
      match /reports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User Settings & Preferences
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
