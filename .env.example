# ==============================================================================
# NeuroCraft Environment Configuration Template (.env.example)
# DO NOT POPULATE REAL SECRETS IN THIS FILE.
# Copy this file to .env for local development: `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=NeuroCraft
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-never-commit
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (Optional: defaults to same-origin /api/v1)
VITE_API_BASE_URL=

# File Upload & Quarantine Safety
MAX_UPLOAD_SIZE_BYTES=104857600
QUARANTINE_DIR=./scratch/quarantine
SCANNER_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 2. Database (Free-First: Local PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neurocraft_user:neurocraft_password@127.0.0.1:5432/neurocraft_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 3. Cache & Queue (Free-First: Local Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
TASK_QUEUE_NAME=neurocraft_tasks

# ------------------------------------------------------------------------------
# 4. Antivirus & Static Signatures (Free-First: Local ClamAV & YARA)
# ------------------------------------------------------------------------------
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15

YARA_RULES_DIR=./yara-rules
YARA_MAX_STRINGS_PER_RULE=10000

# ------------------------------------------------------------------------------
# 5. Machine Learning (Free-First: Local CPU-Optimized ONNX / LightGBM)
# ------------------------------------------------------------------------------
ML_ENGINE_ENABLED=true
ML_EXECUTION_PROVIDER=CPUExecutionProvider
ML_MODEL_PATH=./services/ml-engine/models/pe_classifier_v1.onnx
ML_DECISION_THRESHOLD=0.75
ML_UNCERTAINTY_MARGIN=0.15

# ------------------------------------------------------------------------------
# 6. Threat Intelligence (Optional Enrichment - Default Disabled for Free-First)
# ------------------------------------------------------------------------------
THREAT_INTEL_ENABLED=false
THREAT_INTEL_TIMEOUT_SECONDS=5
# Optional external sources (leave blank in offline/free-first mode)
THREAT_INTEL_API_KEY=

# ------------------------------------------------------------------------------
# 7. LLM & Explainability (Free-First: Local Models e.g., Ollama / llama.cpp)
# ------------------------------------------------------------------------------
LLM_ENABLED=false
LLM_PROVIDER=local-ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=mistral:latest
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# 8. Storage Backend (Free-First: Local Ephemeral Filesystem)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./scratch/storage

# ------------------------------------------------------------------------------
# 9. Blockchain & Decentralized Anchoring (Optional - Default Disabled)
# ------------------------------------------------------------------------------
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=local-evm
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_WALLET_KEY=
